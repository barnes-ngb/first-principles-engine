// ── FROZEN COPY of firestore.rules as it stood BEFORE FIX-265 ────────────────
//
// Base main 065efdec0aa1d216898bf6f4e80b213145ce3e34, byte-for-byte below this
// header. It exists for ONE job: the negative control. A test that shows the new
// rules refuse an old markerless correction proves nothing on its own — it could
// be refusing it for any reason, or the write could be malformed. So the same
// write is replayed against THESE rules, where it must SUCCEED. That is what
// makes the denial attributable to the change rather than to the fixture.
//
// Never deployed, never loaded for the current-rules suites, and deliberately not
// kept in sync: a frozen control that drifts is not a control.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // No public access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Family data — only the owning user can read/write.
    // familyId == the authenticated user's UID.
    match /families/{familyId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == familyId;
    }

    // Chapter book library — global, shared across families.
    // Readable and writable by any authenticated user. Single-family app today;
    // scope writes to admins if multi-family support is ever added.
    match /chapterBooks/{bookId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Shelly Chat threads + messages (explicit for subcollection clarity)
    function isFamily(familyId) {
      return request.auth != null && request.auth.uid == familyId;
    }
    match /families/{familyId}/shellyChatThreads/{threadId} {
      allow read, write: if isFamily(familyId);
      match /messages/{messageId} {
        allow read, write: if isFamily(familyId);
      }
    }
  }
}
